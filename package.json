{
  "name": "ytm",
  "version": "1.0.0",
  "description": "YouTube Music desktop app for Windows",
  "author": "YTM Contributors",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"tsc -w\" \"cpx 'src/renderer/**/*.html' dist/renderer --watch\" \"electron .\"",
    "build": "tsc && cpx \"src/renderer/**/*.html\" dist/renderer && electron-builder --win",
    "test": "jest",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "electron-store": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.0.0",
    "concurrently": "^8.0.0",
    "cpx2": "^4.2.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0"
  }
}
